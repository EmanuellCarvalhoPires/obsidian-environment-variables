{
  "name": "obsidian-environment-variables",
  "version": "1.6.0",
  "description": "Hide API tokens and other sensitive data from AI agents such as Claude Code, Codex and Antigravity. Store them encrypted, reference them in notes by key, and let agents use them in requests without seeing the values.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "secrets",
    "environment variables",
    "mcp",
    "ai"
  ],
  "author": "Emanuell Pires",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "quickjs-emscripten-core": "^0.32.0"
  }
}
